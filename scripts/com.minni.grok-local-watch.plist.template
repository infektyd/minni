<?xml version="1.0" encoding="UTF-8"?>
<!--
  OPTIONAL launchd agent for scripts/grok_local_watch.py — answers GitHub
  mentions from this Mac instead of a GitHub runner.

  This is a TEMPLATE, deliberately not installed by anything in this repo:
  loading it starts a background process that spends your Grok subscription
  on a timer, and that should be a decision you make explicitly.

  Install:
    sed -e "s|__REPO__|$HOME/Projects/Minni|g" -e "s|__HOME__|$HOME|g" \
      scripts/com.minni.grok-local-watch.plist.template \
      > ~/Library/LaunchAgents/com.minni.grok-local-watch.plist
    launchctl load ~/Library/LaunchAgents/com.minni.grok-local-watch.plist

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.minni.grok-local-watch.plist

  Prerequisite (once):
    mkdir -p ~/.grok-local && HOME=~/.grok-local grok login --device-auth

  The trigger below is @grok-local, NOT @grok, so this does not double up with
  .github/workflows/grok.yml. Change it only if you have disabled that workflow.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minni.grok-local-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/grok_local_watch.py</string>
        <string>--repo</string>
        <string>infektyd/minni</string>
        <string>--mention</string>
        <string>@grok-local</string>
        <string>--interval</string>
        <string>180</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.grok/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Long enough that a crash-loop cannot hammer the API. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/minni/grok-local-watch.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/minni/grok-local-watch.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
