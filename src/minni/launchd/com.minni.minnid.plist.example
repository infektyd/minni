<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minni daemon launchd agent — example.

  This is an example, not a live agent. Copy it to
  ~/Library/LaunchAgents/com.minni.minnid.plist, substitute the
  placeholders below, then load it with launchctl.

  Substitutions:
    /path/to/repo/.venv/bin/python
                              absolute path to the repo venv interpreter
    /path/to/repo             absolute path to the Minni repo root
                              (WorkingDirectory)
    /path/to/sock              absolute path to the Unix socket
                               (default: ~/.minni/run/minnid.sock
                               with mode 0600)
    ~                          your home directory; launchd does NOT expand ~,
                               so replace it with the literal /Users/<you>
                               before bootstrapping.

  Install / reload:
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.minni.minnid.plist
    launchctl kickstart -k gui/$UID/com.minni.minnid

  Uninstall:
    launchctl bootout gui/$UID/com.minni.minnid

  Notes:
    Umask 63 == octal 077. Files created by the daemon (logs, sockets if
    chmod is not explicit) end up mode 0600 instead of 0644. This is the
    SEC-016 fix: stderr can contain learning excerpts and must not be
    world-readable.

    Make sure ~/Library/Logs/minni/ exists and is mode 0700
    before first load:
      mkdir -p ~/Library/Logs/minni
      chmod 0700 ~/Library/Logs/minni

    SoftResourceLimits/NumberOfFiles: launchd's default soft fd limit is
    256, which sustained multi-agent load exhausts in minutes (each pooled
    RPC thread holds SQLite handles per database file). At the ceiling,
    accept() fails with EMFILE, clients see EPIPE, AFM helper spawns fail —
    while the job still reports "running". The daemon also raises its own
    rlimit at startup (minnid._raise_fd_ceiling), but the plist floor keeps
    older daemon builds and the window before startup safe. If you already
    have a live plist WITHOUT this key, add it and do a full
    bootout + bootstrap (kickstart alone does not re-read the plist).

    MINNI_AFM_PROVIDER_MODE / MINNI_AFM_NATIVE_HELPER: the daemon runs native
    Apple Foundation Models by default here, mirroring the pair `minni wire`
    writes into installer-managed MCP env blocks (`native_afm_env()` in
    plugins/minni/skills/minni-install/scripts/propagate.py). Hook/MCP/shell
    processes started outside this plist or an installer-written env block
    never see MINNI_AFM_PROVIDER_MODE and fall through to the "bridge"
    default; they defer to the daemon's own AFM verdict in that case (#200).
    Drop both keys (or set MINNI_AFM_PROVIDER_MODE to "bridge"/"auto"/"off")
    to change the daemon's own provider behavior.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minni.minnid</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/repo/.venv/bin/python</string>
        <string>-m</string>
        <string>minni.minnid</string>
        <string>--socket</string>
        <string>/path/to/sock</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/repo</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MINNI_AGENT_ID</key>
        <string>minni</string>
        <key>MINNI_VAULT_PATH</key>
        <string>/Users/REPLACE_WITH_YOUR_USERNAME/.minni/vault</string>
        <key>MINNI_AFM_PROVIDER_MODE</key>
        <string>native</string>
        <key>MINNI_AFM_NATIVE_HELPER</key>
        <string>/path/to/repo/src/minni/native_afm_helper</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/Library/Logs/minni/minnid.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/Library/Logs/minni/minnid.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>
</dict>
</plist>
