{
  "name": "minni-multi-plugin",
  "version": "0.6.0",
  "description": "Local multi-target plugin bridge for Minni (Codex, Claude Code, Gemini, KiloCode).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infektyd/minni.git",
    "directory": "plugins/minni"
  },
  "homepage": "https://github.com/infektyd/minni",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "kilo",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".gemini-plugin",
    ".kilocode-plugin",
    ".mcp.json",
    "commands",
    "hooks",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/emit_build_manifest.mjs",
    "build:server": "tsc && node scripts/emit_build_manifest.mjs",
    "build:server:bundle": "node scripts/bundle_server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-concurrency=4 --import ./tests/setup-env.mjs tests/*.test.mjs",
    "coverage": "npm run build:server && node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=60 --import ./tests/setup-env.mjs tests/*.test.mjs",
    "test:server": "npm run build:server && node --test --test-concurrency=4 --import ./tests/setup-env.mjs tests/*.test.mjs",
    "test:file": "npm run build:server && node --test --import ./tests/setup-env.mjs",
    "design:lint": "npx @google/design.md lint ../../DESIGN.md",
    "test:live:prepare": "npm run build && node tests/live-prepare-task.mjs",
    "smoke:status": "npm run build && node dist/cli.js status",
    "smoke:hook": "npm run build && node dist/hook.js SessionStart < /dev/null",
    "smoke:kilocode-hook": "npm run build && node dist/kilocode-hook.js SessionStart < /dev/null"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.4.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
