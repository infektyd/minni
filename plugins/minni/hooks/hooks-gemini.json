{
  "minni": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node __MINNI_GEMINI_DIST__/gemini-hook.js PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node __MINNI_GEMINI_DIST__/gemini-hook.js SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node __MINNI_GEMINI_DIST__/gemini-hook.js PreInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node __MINNI_GEMINI_DIST__/gemini-hook.js Stop",
        "timeout": 20
      }
    ]
  }
}
